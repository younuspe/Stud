# ── Supru Ecosystem — environment configuration ──────────────────────────────
# All values are optional. Supru runs out-of-the-box with zero keys using the
# built-in Smart Core and keyless providers (Pollinations text + image).

# Optional. Enables Google Gemini models and Veo video. Leave unset to stay keyless.
# GEMINI_API_KEY=

# Optional. Lets Supru Git read private repos and lift the 60 req/hr anonymous
# rate limit without pasting a PAT in the UI. Any of these names work; the
# first one set wins. Needs Contents: Read (Read+Write for future write features).
# GITHUB_TOKEN=
# GH_TOKEN=
# GITHUB_PAT=

# HTTP server
PORT=3000
SUPRU_HOST=0.0.0.0

# Set to "production" to serve the built dist/ bundle instead of the Vite dev
# middleware. `npm run start:prod` sets this for you.
# NODE_ENV=production

# Trusted reverse-proxy hops for X-Forwarded-For (rate-limit keying).
# Defaults to loopback/linklocal/uniquelocal; set to "true" only behind a
# trusted ingress that overwrites the header.
# SUPRU_TRUST_PROXY=loopback, linklocal, uniquelocal

# Default inference provider when the client does not specify one.
# One of: smart_core | pollinations | gemini | nvidia_nim | ollama | lmstudio
# SUPRU_DEFAULT_PROVIDER=smart_core

# Serve the built Vite bundle (dist/) from the Express server in production.
# SUPRU_STATIC_DIR=dist

# Safety: allow /api/terminal/execute to run arbitrary shell commands.
# OFF by default — only enable in a trusted, isolated environment.
# SUPRU_ALLOW_REMOTE_EXEC=false

# Optional shared secret that gates the whole API for public deployments.
# When set, clients must send `Authorization: Bearer <token>` or `x-supru-token`
# (the web client reads VITE_SUPRU_ACCESS_TOKEN or localStorage
# 'supru_access_token'). Leave unset for local/desktop use.
# SUPRU_ACCESS_TOKEN=

# Optional Redis for shared, persistent rate-limit counters across instances.
# ioredis + rate-limit-redis ship as optionalDependencies, so setting REDIS_URL
# is enough; if they are ever absent the server logs a warning and uses the
# in-memory store.
# REDIS_URL=redis://localhost:6379

# Optional outbound error reporting. Receives a JSON payload for every 5xx.
# Works with any HTTPS webhook (Slack/Discord/Opsgenie/custom collector).
# SUPRU_ERROR_WEBHOOK=

# Log level: debug | info | warn | error (default: info in production).
# LOG_LEVEL=info

# Disable request rate limiting (development only).
# SUPRU_DISABLE_RATE_LIMIT=false
