# ── Supru Ecosystem — environment configuration ──────────────────────────────
# All values are optional. Supru runs out-of-the-box with zero keys using the
# built-in Smart Core and keyless providers (Pollinations text + image).

# Optional. Enables Google Gemini models and Veo video. Leave unset to stay keyless.
# GEMINI_API_KEY=

# HTTP server
PORT=3000
SUPRU_HOST=0.0.0.0

# Default inference provider when the client does not specify one.
# One of: smart_core | pollinations | gemini | nvidia_nim | ollama | lmstudio
# SUPRU_DEFAULT_PROVIDER=smart_core

# Serve the built Vite bundle (dist/) from the Express server in production.
# SUPRU_STATIC_DIR=dist

# Safety: allow /api/terminal/execute to run arbitrary shell commands.
# OFF by default — only enable in a trusted, isolated environment.
# SUPRU_ALLOW_REMOTE_EXEC=false

# Disable request rate limiting (development only).
# SUPRU_DISABLE_RATE_LIMIT=false
