{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Supru AI",
  "version": "0.1.0",
  "identifier": "com.supru.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "Supru AI Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "visible": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self' data: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https: blob:; connect-src 'self' https: wss: http: ws:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "public/AppIcon.icns"
    ],
    "resources": [
      "server.ts"
    ],
    "externalBin": [],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": []
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "allowDowngrades": true,
      "nsis": {
        "installerIcon": "public/favicon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.0-37",
          "libayatana-appindicator3-1",
          "librsvg2-common"
        ]
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "updater": {
      "active": false,
      "endpoints": [
        "https://releases.supru.ai/{{target}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwQkQzNzQ1QjY3N0YzQjYKUldTQzBnN3ZJQW1Zc2V5bWlXeVd5eVl5eVl5eVl5eVl5eVl5eVl5eVl5eVl5eVl5eVlkK0RwZ0x6Cg=="
    }
  }
}